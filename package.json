{
  "name": "ctandart-erp",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build",
    "web:preview": "npm --workspace apps/web run preview",
    "api:dev": "cd apps/api && ../../.venv/bin/uvicorn app.main:app --reload",
    "check:python": ".venv/bin/python -m compileall apps/api/app"
  }
}
